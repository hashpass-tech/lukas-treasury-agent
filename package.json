{
  "name": "lukas-treasury-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:local": "tsx scripts/local.ts",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:run": "tsx scripts/demo.ts run",
    "build": "tsx scripts/compile.ts && next build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && tsc --noEmit",
    "test": "vitest run tests/domain.test.ts tests/storage.test.ts tests/attribution.test.ts",
    "test:contracts": "vitest run tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "config:validate": "tsx scripts/ops.ts validate",
    "deploy:sepolia": "tsx scripts/ops.ts sepolia",
    "deploy:mainnet": "tsx scripts/ops.ts mainnet",
    "identity:prepare": "tsx scripts/ops.ts identity",
    "attribution:verify": "tsx scripts/ops.ts attribution",
    "pilot:check": "tsx scripts/ops.ts pilot",
    "evidence:export": "tsx scripts/ops.ts evidence"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@hono/node-server": "1.19.9",
    "@openzeppelin/contracts": "5.2.0",
    "ganache": "7.9.2",
    "hono": "4.13.13",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "solc": "0.8.30",
    "viem": "2.38.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fast-check": "4.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "prettier": "3.6.2"
  }
}
