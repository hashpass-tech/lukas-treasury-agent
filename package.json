{
  "name": "lukas-treasury-agent",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:local": "tsx scripts/local.ts",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:run": "tsx scripts/demo.ts run",
    "demo:commerce": "node --import tsx/esm scripts/demo-commerce.ts",
    "build": "node --import tsx/esm scripts/compile.ts && next build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && tsc --noEmit",
    "test": "vitest run tests/domain.test.ts tests/storage.test.ts tests/attribution.test.ts tests/policy.test.ts tests/signer.test.ts tests/parser.test.ts tests/config.test.ts tests/identity.test.ts tests/commerce.test.ts",
    "test:contracts": "tsx scripts/foundry.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "config:validate": "tsx scripts/ops.ts validate",
    "deploy:sepolia": "tsx scripts/sepolia.ts deploy",
    "deploy:mainnet": "tsx scripts/mainnet.ts",
    "identity:prepare": "tsx scripts/identity.ts prepare",
    "attribution:verify": "tsx scripts/ops.ts attribution",
    "pilot:check": "tsx scripts/readiness.ts",
    "evidence:export": "tsx scripts/ops.ts evidence",
    "dev:api": "tsx scripts/api.ts",
    "dev:worker": "tsx scripts/worker.ts",
    "demo:sepolia": "tsx scripts/sepolia.ts demo",
    "test:foundry": "tsx scripts/foundry.ts",
    "identity:verify": "tsx scripts/identity.ts verify",
    "snapshot:sync": "tsx scripts/snapshot.ts",
    "oracle:sync": "tsx scripts/oracle.ts",
    "test:sepolia-path": "vitest run tests/sepolia-path.test.ts",
    "demo:capture": "tsx scripts/capture-demo.ts",
    "signer:setup": "tsx scripts/signer-setup.ts",
    "signer:start": "tsx scripts/signer.ts",
    "specs:list": "node scripts/versioning.mjs tasks list",
    "specs:sync": "node scripts/versioning.mjs tasks sync",
    "specs:validate": "node scripts/versioning.mjs tasks validate",
    "versioning:readme": "pnpm exec versioning update-readme --readme README.md --changelog CHANGELOG.md --pkg package.json",
    "versioning:changelog:check": "pnpm exec versioning check-changelog --changelog CHANGELOG.md",
    "versioning:metadata:check": "node scripts/check-release-metadata.mjs",
    "release:metadata:check": "node scripts/check-release-metadata.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepare": "husky"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@hono/node-server": "1.19.9",
    "@openzeppelin/contracts": "5.2.0",
    "ganache": "7.9.2",
    "hono": "4.13.13",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "solc": "0.8.30",
    "viem": "2.38.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@edcalderon/versioning": "1.5.13",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fast-check": "4.3.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
