pragma solidity ^0.8.30;
import '../../packages/contracts/Treasury.sol';
interface Vm {function addr(uint256) external returns(address);function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32);function prank(address) external;function warp(uint256) external;function expectRevert() external;}
contract NativeIndexFixture {function getIndexUSD() external view returns(uint256,uint256){return (9518750,block.timestamp-10);}}
contract TokenFeedFixture {function decimals() external pure returns(uint8){return 8;}function latestRoundData() external view returns(uint80,int256,uint256,uint256,uint80){return(1,25000,block.timestamp-20,block.timestamp-20,1);}}
contract ContractOwner {bytes32 public expected;function approve(bytes32 value) external {expected=value;}function isValidSignature(bytes32 hash,bytes calldata signature) external view returns(bytes4){return hash==expected&&keccak256(signature)==keccak256(hex'deadbeef')?bytes4(0x1626ba7e):bytes4(0xffffffff);}}
contract SenderFeeToken is ERC20 {
    constructor() ERC20('Bad sender fee','BAD'){_mint(msg.sender,1e30);}
    function _update(address from,address to,uint256 amount) internal override {super._update(from,to,amount);if(from!=address(0)&&to!=address(0))super._update(from,address(0),1);}
}
contract CallbackToken is ERC20 {
    TreasuryVault public target; bytes private payload;
    constructor() ERC20('Reentrant','REENT'){_mint(msg.sender,1e30);}
    function attack(TreasuryVault vault,bytes memory data) external {target=vault;payload=data;}
    function _update(address from,address to,uint256 amount) internal override {super._update(from,to,amount);if(address(target)!=address(0)&&from==address(target)){(bool ok,)=address(target).call(payload);require(ok,'CALLBACK_REJECTED');}}
}
contract TreasuryTest {
    Vm vm=Vm(address(uint160(uint256(keccak256('hevm cheat code')))));
    uint256 constant OWNER_KEY=7;address owner;address recipient=address(0x1234);
    TreasuryVault vault;SimulationToken token;FixtureOracle oracle;
    bytes32 method=keccak256('lukas-raw-currency-basket:v1:BRL4000,MXN3000,COP1500,CLP1000,ARS500');
    function setUp() public {vm.warp(1_000_000);owner=vm.addr(OWNER_KEY);token=new SimulationToken(6);oracle=new FixtureOracle(address(this));oracle.publish(95187500000000000,250000000000000,uint64(block.timestamp),method);vault=new TreasuryVault(owner,address(this),address(oracle),method);vm.prank(owner);vault.setToken(address(token),6,true,1e15,2e15);vm.prank(owner);vault.setRecipient(recipient,true);token.transfer(address(vault),1e15);}
    function intent(bytes32 id,uint256 amount,address asset) internal view returns(TreasuryVault.Intent memory){return TreasuryVault.Intent(id,address(vault),address(0),asset,recipient,amount,1e25,uint64(block.timestamp),uint64(block.timestamp+1000),vault.policyEpoch(),method,id);}
    function signature(TreasuryVault.Intent memory i) internal returns(bytes memory){(uint8 v,bytes32 r,bytes32 s)=vm.sign(OWNER_KEY,vault.intentHash(i));return abi.encodePacked(r,s,v);}
    function testFuzzExactCeiling(uint64 amount) public view {uint256 a=uint256(amount)+1;TreasuryVault.Intent memory i=intent(bytes32(a),a,address(token));uint256 n=a*95187500000000000*1e6;uint256 d=1e18*250000000000000;require(vault.previewPayment(i,1)==n/d+(n%d==0?0:1),'ROUNDING');}
    function testReplayAndDailyBucket() public {TreasuryVault.Intent memory i=intent(bytes32(uint256(1)),100e18,address(token));bytes memory sig=signature(i);vault.executePayment(i,sig,1);require(vault.dailySpent(address(token),block.timestamp/86400)==38075000000,'SPENT');vm.expectRevert();vault.executePayment(i,sig,1);}
    function testSenderFeeRejectedAndMarkersRolledBack() public {SenderFeeToken bad=new SenderFeeToken();vm.prank(owner);vault.setToken(address(bad),18,true,1e29,1e30);bad.transfer(address(vault),1e25);TreasuryVault.Intent memory i=intent(bytes32(uint256(2)),1e18,address(bad));bytes memory sig=signature(i);uint256 beforeBalance=bad.balanceOf(address(vault));vm.expectRevert();vault.executePayment(i,sig,1);require(!vault.isPaid(i.obligationId)&&bad.balanceOf(address(vault))==beforeBalance,'ROLLBACK');}
    function testReentrancyRejectedAndCountersRolledBack() public {CallbackToken bad=new CallbackToken();vm.prank(owner);vault.setToken(address(bad),18,true,1e29,1e30);bad.transfer(address(vault),1e25);TreasuryVault.Intent memory i=intent(bytes32(uint256(3)),1e18,address(bad));bytes memory sig=signature(i);bad.attack(vault,abi.encodeCall(vault.executePayment,(i,sig,1)));vm.expectRevert();vault.executePayment(i,sig,1);require(!vault.isPaid(i.obligationId),'ROLLBACK');}
    function testPauseCancelEpochAndWithdrawalIndependentOfExecutor() public {TreasuryVault.Intent memory i=intent(bytes32(uint256(4)),1e18,address(token));bytes memory sig=signature(i);vm.prank(owner);vault.pause();vm.expectRevert();vault.executePayment(i,sig,1);vm.prank(owner);vault.withdraw(address(token),owner,1);require(token.balanceOf(owner)==1,'OWNER_WITHDRAW');vm.prank(owner);vault.unpause();vm.prank(owner);vault.setExecutor(address(0x5678));vm.expectRevert();vault.executePayment(i,sig,1);vm.prank(owner);vault.cancelIntent(i.obligationId);require(vault.canceled(i.obligationId),'CANCEL');}
    function testUTCReset() public {vm.prank(owner);vault.setToken(address(token),6,true,38075000000,38075000000);TreasuryVault.Intent memory i=intent(bytes32(uint256(5)),100e18,address(token));vault.executePayment(i,signature(i),1);TreasuryVault.Intent memory j=intent(bytes32(uint256(6)),100e18,address(token));bytes memory sig=signature(j);vm.expectRevert();vault.executePayment(j,sig,1);vm.warp((block.timestamp/86400+1)*86400);oracle.publish(95187500000000000,250000000000000,uint64(block.timestamp),method);j=intent(bytes32(uint256(6)),100e18,address(token));vault.executePayment(j,signature(j),2);require(vault.isPaid(j.obligationId),'NEXT_DAY');}
    function testERC1271OwnerBoundToExactIntent() public {ContractOwner smart=new ContractOwner();TreasuryVault v=new TreasuryVault(address(smart),address(this),address(oracle),method);vm.prank(address(smart));v.setToken(address(token),6,true,1e15,1e15);vm.prank(address(smart));v.setRecipient(recipient,true);vm.prank(owner);vault.withdraw(address(token),address(v),1e12);TreasuryVault.Intent memory i=intent(bytes32(uint256(7)),1e18,address(token));i.vault=address(v);i.policyEpoch=v.policyEpoch();smart.approve(v.intentHash(i));i.amountLukasWad=2e18;vm.expectRevert();v.executePayment(i,hex'deadbeef',1);i.amountLukasWad=1e18;v.executePayment(i,hex'deadbeef',1);require(v.isPaid(i.obligationId),'SMART_OWNER');}
    function mirrorSignature(SignedMirrorOracle mirror,uint256[5] memory prices,uint64[5] memory times,uint64 tokenTime) internal returns(bytes memory) {bytes32 snapshotHash=keccak256(abi.encode(prices,times,uint256(250000000000000),tokenTime));bytes32 structHash=keccak256(abi.encode(keccak256('Snapshot(bytes32 snapshotHash,uint256 sourceChainId,address sourceContract,bytes32 sourceBlockHash,bytes32 methodologyHash)'),snapshotHash,uint256(137),address(0x9999),keccak256('source-block'),method));bytes32 d=keccak256(abi.encode(keccak256('EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)'),keccak256('LUKAS Price Mirror'),keccak256('1'),block.chainid,address(mirror)));(uint8 v,bytes32 r,bytes32 s)=vm.sign(OWNER_KEY,keccak256(abi.encodePacked('\x19\x01',d,structHash)));return abi.encodePacked(r,s,v);}
    function testSignedMirrorBindsSourceAndRejectsReplayAndChangedPrices() public {SignedMirrorOracle mirror=new SignedMirrorOracle(owner,method,137,address(0x9999),300);uint256[5] memory p=[uint256(200000000000000000),50000000000000000,250000000000000,1000000000000000,1000000000000000];uint64[5] memory t=[uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp)];uint64 tokenTime=uint64(block.timestamp-20);bytes memory sig=mirrorSignature(mirror,p,t,tokenTime);p[0]++;vm.expectRevert();mirror.publish(p,t,250000000000000,tokenTime,keccak256('source-block'),sig);p[0]--;mirror.publish(p,t,250000000000000,tokenTime,keccak256('source-block'),sig);(uint256 value,,uint64 sourceTime,)=mirror.rounds(1);require(value==95187500000000000&&sourceTime==tokenTime,'MIRROR_VALUE_TIME');vm.expectRevert();mirror.publish(p,t,250000000000000,tokenTime,keccak256('source-block'),sig);}
    function testSignedMirrorCannotFreshenStaleComponents() public {SignedMirrorOracle mirror=new SignedMirrorOracle(owner,method,137,address(0x9999),300);uint256[5] memory p=[uint256(200000000000000000),50000000000000000,250000000000000,1000000000000000,1000000000000000];uint64[5] memory t=[uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp),uint64(block.timestamp-301)];bytes memory sig=mirrorSignature(mirror,p,t,uint64(block.timestamp));vm.expectRevert();mirror.publish(p,t,250000000000000,uint64(block.timestamp),keccak256('source-block'),sig);}
    function testNativeIndexNormalizesScaleAndKeepsOldestOriginalTime() public {NativeIndexFixture source=new NativeIndexFixture();TokenFeedFixture feed=new TokenFeedFixture();NativeIndexOracle nativeOracle=new NativeIndexOracle(address(source),address(feed),method);nativeOracle.capture();(uint256 index,uint256 price,uint64 updatedAt,)=nativeOracle.rounds(1);require(index==95187500000000000&&price==250000000000000&&updatedAt==block.timestamp-20,'NATIVE_SCALE_TIME');}
}
