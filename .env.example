MODE=LOCAL
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
DATABASE_PATH=.local/treasury.sqlite
# Never use local development identities on remote networks.
# Remote modes require HTTPS RPC, separate role wallets, a constrained remote signer and encrypted journal.
MAINNET_WRITES=false
ATTRIBUTION_CODE=celo_41fbb6a88a82
# Assign one permanent agent wallet before any mainnet activity. Never use demo accounts.
AGENT_WALLET_ADDRESS=0x114d72D97Aa9C413A1ba3f0Cd37F439D668EA1aD
ORACLE_MODE=fixture

# For CELO_SEPOLIA only; use a separate database/manifest directory.

# Replace or unset the LOCAL RPC_URL above when changing mode.
CELO_SEPOLIA_RPC_URL=
CELO_MAINNET_RPC_URL=
MERCHANT_WALLET_ADDRESS=
DEPLOYER_WALLET_ADDRESS=
PUBLISHER_WALLET_ADDRESS=
RECIPIENT_ADDRESS=
SIGNER_URL=
OWNER_SIGNER_URL=
DEPLOYER_SIGNER_URL=
PUBLISHER_SIGNER_URL=
# Network credentials are securely injected; never put credential values here.
JOURNAL_KEY_FILE=
MAXIMUM_GAS_COST_NATIVE_ATOMIC=
CONFIRMATIONS=5
PUBLIC_ORIGIN=http://127.0.0.1:3000
DEPLOYMENT_MANIFEST=.local/deployment.json
SNAPSHOT_PATH=.local/snapshot.json
PENDING_REPLACEMENT_MS=120000

# Canonical identity requires code/implementation hashes checked through the actual chain RPC.
REGISTRY_CODE_HASH=
REGISTRY_IMPLEMENTATION_CODE_HASH=
ERC8004_AGENT_ID=
REGISTRATION_URI=

# Mainnet preparation: operator-provided reviewed metadata/config, not invented defaults.
MAINNET_PLAN_CONFIG=
MAINNET_TOKEN_METADATA=
SECURITY_REVIEW_FILE=
MAINNET_AUTHORIZATION_FILE=
NATIVE_SOURCE_CONFIG=
MIRROR_ATTESTATION_FILE=
SOURCE_CHAIN_ID=

# Signer host only. Keep signing keys outside the application host and repository.
SIGNER_ROLE=executor
SIGNER_PRIVATE_KEY_FILE=
SIGNER_AUTH_TOKEN_FILE=
SIGNER_TLS_CERT_FILE=
SIGNER_TLS_KEY_FILE=
SIGNER_DATABASE_PATH=.local/signer.sqlite
SIGNER_TRANSACTION_APPROVAL_FILE=
OWNER_INTENT_APPROVAL_FILE=
